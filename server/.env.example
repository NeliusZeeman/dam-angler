# Copy to server/.env on the server (never commit the real one).
DATABASE_URL=postgresql://nelius_app:CHANGE_ME@localhost:5432/dam_anglers
# The game's tables go in their own schema.
DB_SCHEMA=angler
PORT=8100
HOST=127.0.0.1
# Cookies only over HTTPS (the Cloudflare Tunnel). Set to false for plain-http local testing.
SECURE_COOKIES=true
