# Dam Angler v2 API (accounts, cloud saves, dam stats).
# Install: sudo cp server/deploy/dam-angler-api.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now dam-angler-api
[Unit]
Description=Dam Angler v2 API
After=network.target postgresql.service

[Service]
User=nelius
WorkingDirectory=/home/nelius/online_app/dam-angler-v2
ExecStart=/usr/bin/node --env-file=server/.env server/index.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
